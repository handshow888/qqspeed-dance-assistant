# Python environments and caches
/.venv/
/venv/
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated output and local runtime data
/debug/
/recordings/
/build/
/dist/
*.egg-info/
*.log
*.tmp
*.bak

# Editors and operating-system metadata
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini

